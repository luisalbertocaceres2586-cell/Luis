{
  // Migración gradual a TypeScript: los archivos .js listados abajo se revisan con tipos (checkJs)
  // SIN cambiar cómo se publica el juego (siguen siendo .js que carga el navegador).
  // Para sumar un archivo a la revisión: agrégalo a "include" y corrige lo que marque.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "engine/ui/mundos-registro.js",
    "engine/ui/selector-mundos.js",
    "engine/nivel1/perfiles.js"
  ]
}
