{
  "name": "ninja-multiplicacion",
  "version": "1.0.0",
  "private": true,
  "description": "Juego educativo de tablas de multiplicar con estética ninja",
  "scripts": {
    "typecheck": "npm run typecheck:estricto && npm run typecheck:basico",
    "typecheck:estricto": "tsc -p tsconfig.json",
    "typecheck:basico": "tsc -p tsconfig.basico.json",
    "test": "node tests/run-all.js",
    "verify": "npm run typecheck && npm test",
    "subir": "node tools/subir.js",
    "rama": "node tools/flujo.js rama",
    "estado": "node tools/flujo.js estado",
    "radar": "node tools/flujo.js radar",
    "sincronizar": "node tools/flujo.js sincronizar",
    "configurar": "node tools/flujo.js configurar",
    "publicar": "node tools/publicar-version.js",
    "webp": "python3 tools/convertir_webp.py --umbral 35",
    "precache": "node tools/generar_precache.js",
    "presupuesto": "node tools/presupuesto.js",
    "optimizar": "node tools/optimizar_imagenes.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
